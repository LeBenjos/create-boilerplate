{
    "name": "@benjos/create-boilerplate",
    "version": "1.5.11",
    "description": "CLI to scaffold Three.js projects (experiences and POCs)",
    "type": "module",
    "bin": {
        "create-boilerplate": "./dist/index.js"
    },
    "files": [
        "dist",
        "templates"
    ],
    "scripts": {
        "build": "node -e \"fs.rmSync('dist',{recursive:true,force:true})\" && tsc",
        "dev": "tsc --watch",
        "test": "npm run build && node --test test/",
        "prepublishOnly": "npm test && node ../scripts/check-pack.js"
    },
    "keywords": [
        "three.js",
        "boilerplate",
        "cli",
        "scaffold",
        "vanilla"
    ],
    "author": "Benjamin Schinkel",
    "license": "MIT",
    "engines": {
        "node": ">=20.12.0"
    },
    "repository": {
        "type": "git",
        "url": "https://github.com/LeBenjos/boilerplate.git"
    },
    "homepage": "https://github.com/LeBenjos/boilerplate#readme",
    "dependencies": {
        "@inquirer/prompts": "^8.7.3",
        "commander": "^15.0.0"
    },
    "devDependencies": {
        "@types/node": "^26.6.5",
        "typescript": "~6.0.3"
    }
}
