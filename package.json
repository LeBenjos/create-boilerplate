{
    "name": "create-boilerplate",
    "private": true,
    "version": "1.5.11",
    "workspaces": [
        "packages"
    ],
    "type": "module",
    "scripts": {
        "lint": "eslint . --max-warnings 0",
        "lint:fix": "eslint . --fix",
        "format": "prettier --write \"**/src/**\" \"packages/test/**\"",
        "format:check": "prettier --check \"**/src/**\" \"packages/test/**\"",
        "bump": "node scripts/version.js",
        "update:deps": "npx -y npm-check-updates -u --deep --install always",
        "test": "npm test --workspace packages"
    },
    "devDependencies": {
        "@eslint/js": "^10.0.1",
        "eslint": "^10.13.0",
        "eslint-config-prettier": "^10.1.8",
        "eslint-plugin-prettier": "^5.5.7",
        "prettier": "^3.9.10",
        "typescript-eslint": "^8.71.2"
    }
}
